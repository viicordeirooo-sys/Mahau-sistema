# Planilhas de dados (Vercel serve a raiz publicamente — nunca commitar dados reais)
*.xlsx
*.xls

# Documento de planejamento interno
PLANO_TECNICO_CONCILIACAO_MAHAU.md

# Dependências locais e scripts temporários de inspeção
node_modules/

# Segredos — nunca commitar (a raiz é servida publicamente pelo Vercel)
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
credentials.json
secrets.json
service-account*.json

# Firebase Admin SDK keys (default download names)
*-firebase-adminsdk-*.json
roles.json

# Config local do Claude Code (não depender do exclude global do git)
.claude/

# Artefatos temporários de inspeção/checagem (node --check, extrações de funções)
.__check.js
*.check.js
_tmp_*.txt
