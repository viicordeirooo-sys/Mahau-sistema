rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Regras do Firestore — Mahau Sistema
//
// ⚠️ ESTE ARQUIVO É REFERÊNCIA / VERSIONAMENTO.
// As regras são aplicadas pelo console do Firebase
// (Firestore Database → Regras → colar → Publicar), NÃO por deploy automático.
// Reversão: o console mantém histórico — basta republicar a versão anterior.
//
// Histórico de versões desta política:
//   v1  ABERTA      → allow read, write: if true;            (banco público)
//   v2  AUTENTICADA → allow read, write: if request.auth != null;
//   v3  RBAC        → ESTA versão (papéis por custom claim "role").
// ─────────────────────────────────────────────────────────────────────────────
//
// ── MODELO RBAC ────────────────────────────────────────────────────────────────
// Papel vem do custom claim "role" no token JWT (setado por set-claims.mjs, fora
// daqui). Sem auth / sem role / role desconhecido  →  NEGA TUDO (deny-by-default).
//
//   R = read · W = create/update · D = delete (permanente)
//   OBS: soft-delete e restore são UPDATE (gravam/limpam `deletedAt`), logo entram
//        em W — quem tem W numa coleção pode mandar p/ a Lixeira e restaurar nela.
//        D (delete real do Firestore) = exclusão permanente, só admin.
//
//   ┌──────────────────────┬───────┬─────────┬───────┐
//   │ Coleção              │ admin │ manager │ staff │
//   ├──────────────────────┼───────┼─────────┼───────┤
//   │ produtos             │ RWD   │ RW      │ R     │
//   │ mapeamento_zig       │ RWD   │ RW      │ R     │
//   │ skus_zig             │ RWD   │ RW      │ R     │
//   │ semanas_conciliacao  │ RWD   │ RW      │ R     │
//   │ estoques             │ RWD   │ RW      │ RW    │
//   │ vendas_zig           │ RWD   │ RW      │ RW    │
//   │ fichas               │ RWD   │ R       │ —     │
//   │ compras              │ RWD   │ R       │ —     │
//   │ eventos              │ RWD   │ R       │ —     │
//   │ custos               │ RWD   │ R       │ —     │
//   │ inventarios          │ RWD   │ R       │ —     │
//   │ inventarios_mensais  │ RWD   │ R       │ —     │
//   │ cortesias_semana     │ RWD   │ R       │ —     │
//   │ estornos_semana      │ RWD   │ R       │ —     │
//   │ conciliacoes         │ RWD   │ R       │ —     │
//   │ config/*             │ RWD   │ R       │ —     │
//   │ lixeira/*            │ RWD   │ —       │ —     │
//   └──────────────────────┴───────┴─────────┴───────┘
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function role()      { return request.auth != null ? request.auth.token.role : null; }
    function isAdmin()   { return role() == "admin"; }
    function isManager() { return role() == "manager"; }
    function isStaff()   { return role() == "staff"; }

    // ── Validação de schema (Nível B tolerante: campos opcionais, validados quando presentes; sem hasOnly) ──
    function numOk(d, k, teto) {
      return !(k in d) || (d[k] is number && d[k] >= 0 && d[k] <= teto);
    }
    function strOk(d, k, maxlen) {
      return !(k in d) || (d[k] is string && d[k].size() <= maxlen);
    }
    function tsOk(d, k) {
      return !(k in d) || d[k] is timestamp || d[k] is string;
    }
    function produtoOk(d) {
      return d is map
        && strOk(d, 'nome', 200)
        && strOk(d, 'categoria', 60)
        && strOk(d, 'unidade', 20)
        && strOk(d, 'orgId', 100)
        && strOk(d, 'id', 200)
        && tsOk(d, 'createdAt')
        && tsOk(d, 'updatedAt')
        && tsOk(d, 'deletedAt')
        && numOk(d, 'capacidade_ml', 1000000)
        && numOk(d, 'preco_compra', 1000000)
        && numOk(d, 'preco_venda', 1000000)
        && numOk(d, 'estoque_min', 1000000)
        && numOk(d, 'estoque_inicial', 1000000);
    }

    function arrOk(d, k)  { return !(k in d) || d[k] is list; }
    function mapOk(d, k)  { return !(k in d) || d[k] is map; }
    function boolOk(d, k) { return !(k in d) || d[k] is bool; }

    // espinha comum (id/orgId/timestamps) — usada pelas coleções sem schema campo-a-campo ainda
    function espinhaOk(d) {
      return d is map
        && strOk(d, 'id', 200) && strOk(d, 'orgId', 100)
        && tsOk(d, 'createdAt') && tsOk(d, 'updatedAt') && tsOk(d, 'deletedAt');
    }

    function estoqueOk(d) {
      return d is map
        && strOk(d,'id',200) && strOk(d,'orgId',100) && strOk(d,'mes',20)
        && strOk(d,'semana_id',200) && strOk(d,'tipo',40)
        && tsOk(d,'data_contagem') && tsOk(d,'createdAt') && tsOk(d,'updatedAt') && tsOk(d,'deletedAt')
        && arrOk(d,'produtos');
    }
    function vendaZigOk(d) {
      return d is map
        && strOk(d,'id',200) && strOk(d,'orgId',100) && strOk(d,'mes',20) && strOk(d,'semana_id',200)
        && tsOk(d,'periodo_inicio') && tsOk(d,'periodo_fim')
        && tsOk(d,'createdAt') && tsOk(d,'updatedAt') && tsOk(d,'deletedAt')
        && arrOk(d,'itens');
    }
    function mapeamentoOk(d) {
      return d is map
        && strOk(d,'id',200) && strOk(d,'orgId',100) && strOk(d,'nome_zig',300)
        && strOk(d,'sku_zig',100) && strOk(d,'tipo',40)
        && strOk(d,'mixer_nome',300) && strOk(d,'mixer_produto_id',200)
        && boolOk(d,'ativo')
        && numOk(d,'garrafa_qtd',1000000) && numOk(d,'redbull_qtd',1000000) && numOk(d,'preco_zig',1000000)
        && tsOk(d,'createdAt') && tsOk(d,'updatedAt')
        && arrOk(d,'regras');
    }
    function semanaOk(d) {
      return d is map
        && strOk(d,'id',200) && strOk(d,'orgId',100) && strOk(d,'mes',20) && strOk(d,'status',40)
        && tsOk(d,'periodo_inicio') && tsOk(d,'periodo_fim')
        && tsOk(d,'createdAt') && tsOk(d,'updatedAt') && tsOk(d,'deletedAt');
    }
    function conciliacaoOk(d) {
      return d is map
        && strOk(d,'id',200) && strOk(d,'orgId',100) && strOk(d,'mes',20) && strOk(d,'semana_id',200)
        && tsOk(d,'periodo_inicio') && tsOk(d,'periodo_fim') && tsOk(d,'gerado_em')
        && tsOk(d,'createdAt') && tsOk(d,'updatedAt')
        && numOk(d,'total_falta',1000000) && numOk(d,'total_sobra',1000000)
        && mapOk(d,'contagem') && mapOk(d,'meta') && arrOk(d,'resultados');
    }

    // ── TIER A · operacional restrito ─────────────────────────────────────────
    //    read: admin + manager   ·   create/update + delete: admin
    match /fichas/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /compras/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /eventos/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /custos/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /inventarios/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /inventarios_mensais/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /cortesias_semana/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /estornos_semana/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /conciliacoes/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin() && conciliacaoOk(request.resource.data);
      allow delete:         if isAdmin();
    }

    // ── TIER B · catálogo / mapeamento compartilhado ──────────────────────────
    //    read: admin + manager + staff   ·   create/update: admin + manager   ·   delete: admin
    match /produtos/{doc} {
      allow read:           if isAdmin() || isManager() || isStaff();
      allow create, update: if (isAdmin() || isManager()) && produtoOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /mapeamento_zig/{doc} {
      allow read:           if isAdmin() || isManager() || isStaff();
      allow create, update: if (isAdmin() || isManager()) && mapeamentoOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /skus_zig/{doc} {
      allow read:           if isAdmin() || isManager() || isStaff();
      allow create, update: if (isAdmin() || isManager()) && espinhaOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /semanas_conciliacao/{doc} {
      allow read:           if isAdmin() || isManager() || isStaff();
      allow create, update: if (isAdmin() || isManager()) && semanaOk(request.resource.data);
      allow delete:         if isAdmin();
    }

    // ── TIER C · contagem / saída operacional ─────────────────────────────────
    //    read + create/update: admin + manager + staff   ·   delete: admin
    match /estoques/{doc} {
      allow read:           if isAdmin() || isManager() || isStaff();
      allow create, update: if (isAdmin() || isManager() || isStaff()) && estoqueOk(request.resource.data);
      allow delete:         if isAdmin();
    }
    match /vendas_zig/{doc} {
      allow read:           if isAdmin() || isManager() || isStaff();
      allow create, update: if (isAdmin() || isManager() || isStaff()) && vendaZigOk(request.resource.data);
      allow delete:         if isAdmin();
    }

    // ── config (singleton config/settings) ────────────────────────────────────
    //    read: admin + manager   ·   create/update + delete: admin
    match /config/{doc} {
      allow read:           if isAdmin() || isManager();
      allow create, update: if isAdmin();
      allow delete:         if isAdmin();
    }

    // ── lixeira ───────────────────────────────────────────────────────────────
    //    admin only. NOTA: hoje NÃO existe coleção `lixeira` — a Lixeira do app é o
    //    campo `deletedAt` nos docs das coleções acima (soft-delete = update). Esta
    //    regra é defensiva/forward-looking caso uma coleção `lixeira` passe a existir.
    match /lixeira/{document=**} {
      allow read, write: if isAdmin();
    }

    // ── DEFAULT DENY ───────────────────────────────────────────────────────────
    //    O Firestore já nega por padrão tudo que não casa com um `allow` acima;
    //    esta regra explícita deixa a intenção registrada e cobre subcoleções
    //    inesperadas. Regras são ADITIVAS: este `if false` NÃO revoga os allows
    //    específicos acima.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
